# Copy to .env and fill in. Never commit .env. Use fake data and staging keys only (spec section 12).

# --- Docker Compose database ---
POSTGRES_DB=bm_enterprises
POSTGRES_USER=bm_app
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432
POSTGRES_EXTERNAL_PORT=5432
DB_HOST=db

# --- Ports ---
BACKEND_EXTERNAL_PORT=8000
FRONTEND_EXTERNAL_PORT=5173
PGADMIN_EXTERNAL_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me-locally

# --- Backend ---
ENVIRONMENT=development
# Personal deductions remain disabled pending the documented D16 review.
PAYROLL_DEDUCTIONS_ENABLED=false
CORS_ALLOWED_ORIGINS=http://localhost:5173
ENABLE_API_DOCS=true

# Per-process sliding windows. Configure shared edge/store limits before multiple workers.
RATE_LIMIT_FAILED_AUTH_PER_MINUTE=20
RATE_LIMIT_WEBHOOK_PER_MINUTE=120
RATE_LIMIT_API_IP_PER_MINUTE=600
RATE_LIMIT_API_USER_PER_MINUTE=120
RATE_LIMIT_UPLOAD_IP_PER_MINUTE=30
RATE_LIMIT_UPLOAD_USER_PER_MINUTE=10

# --- Clerk (backend verifies tokens locally against the JWKS) ---
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_AUTHORIZED_PARTIES=http://localhost:5173
CLERK_AUDIENCE=
CLERK_WEBHOOK_SECRET=whsec_replace_me
# Server-side only; used by the reconciliation job. Never expose to the frontend.
CLERK_SECRET_KEY=sk_test_replace_me

# --- Supabase Storage (private bucket for OR documents; service key stays server-side) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=replace_me
SUPABASE_BUCKET=delivery-documents
SIGNED_URL_TTL_SECONDS=120

# --- Frontend (publishable key is public by design) ---
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# Leave empty to use the same-origin Vite API proxy when sharing through ngrok.
VITE_API_BASE_URL=http://localhost:8000
# Exact public frontend origin, when sharing; enables its hostname in Vite.
VITE_PUBLIC_FRONTEND_URL=
